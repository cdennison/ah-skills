# Copy to .env, then replace every placeholder with a value for this host:
# cp .env.example .env
# Keep .env out of version control. This file intentionally contains no
# credentials, host IPs, or usable endpoint values.

# GitHub Personal Access Token (no scopes needed, just raises the rate limit
# from 60 to 5,000 requests/hour). Used only by clone_repos.py.
GITHUB_PAT=replace-with-github-token

# Optional scan publication settings. These are required only when invoking
# `batch_pipeline.py --publish-scans`; publication is off unless that flag is
# present. Set VETTD_CLI_BIN to an absolute executable path on this host.
VETTD_CLI_BIN=/absolute/path/to/vettd-cli
VETTD_SCAN_ENDPOINT=https://backend.example.invalid/api/scans/ingest
VETTD_API_KEY=replace-with-vettd-api-key
# Non-secret identity check: use dev@localhost for local development; on EC2,
# replace with the intended production backend account email.
VETTD_EXPECTED_ACCOUNT_EMAIL=replace-with-intended-account-email

# The publisher/scanner may write caches under HOME. Use an isolated writable
# directory per host; do not point this at a shared or read-only home.
HOME=/absolute/path/to/isolated-writable-home

# Choose exactly one Qdrant mode in the real .env. For embedded mode, set the
# database path and leave SKILLS_QDRANT_URL unset. For Docker/server mode, set
# the URL and explicitly unset SKILLS_QDRANT_DB_PATH (an old DB_PATH wins).
# SKILLS_QDRANT_DB_PATH=/absolute/path/to/qdrant_db
# SKILLS_QDRANT_URL=http://localhost:6333
