          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "mcp_id": {
            "type": "string",
            "title": "Mcp Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "readme": {
            "type": "string",
            "title": "Readme"
          },
          "repo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Url"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mcp_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mcp Category"
          },
          "mcp_category_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mcp Category Source"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "registry_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registry Type"
          },
          "package_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Identifier"
          },
          "package_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Url"
          },
          "deployment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment"
          },
          "has_installable_package": {
            "type": "boolean",
            "title": "Has Installable Package"
          },
          "has_remote": {
            "type": "boolean",
            "title": "Has Remote"
          },
          "attributes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attributes"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "added": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added"
          }
        },
        "type": "object",
        "required": [
          "score",
          "rank",
          "mcp_id",
          "name",
          "description",
          "readme",
          "repo_url",
          "status",
          "mcp_category",
          "mcp_category_source",
          "sources",
          "registry_type",
          "package_identifier",
          "package_url",
          "deployment",
          "has_installable_package",
          "has_remote",
          "attributes",
          "license",
          "added"
        ],
        "title": "McpHit"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Free-text search query; empty string browses instead.",
            "default": ""
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "skill",
              "mcp"
            ],
            "title": "Asset Type",
            "description": "Which collection to search: 'skill' (agent_skills) or 'mcp' (mcp_servers).",
            "default": "skill"
          },
          "limit": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          },
          "min_stars": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Stars"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "default": []
          },
          "rank_filters": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Rank Filters"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages",
            "description": "skill only: only return hits whose language is in this list.",
            "default": []
          },
          "agent_compatibility": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Agent Compatibility",
            "description": "skill only: only return hits whose agent_compatibility overlaps this list.",
            "default": []
          },
          "mcp_category": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Mcp Category",
            "description": "mcp only: filter to server/client/framework/tooling.",
            "default": []
          },
          "deployment": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Deployment",
            "description": "mcp only: filter to local/remote/hybrid.",
            "default": []
          },
          "registry_type": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Registry Type",
            "description": "mcp only: filter to npm/pypi/oci/etc.",
            "default": []
          }
        },
        "type": "object",
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "index_ready": {
            "type": "boolean",
            "title": "Index Ready"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "skill",
              "mcp"
            ],
            "title": "Asset Type"
          },
          "hits": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SkillHit"
                },
                "type": "array"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/McpHit"
                },
                "type": "array"
              }
            ],
            "title": "Hits"
          }
        },
        "type": "object",
        "required": [
          "index_ready",
          "query",
          "asset_type",
          "hits"
        ],
        "title": "QueryResponse"
      },
      "ScanFinding": {
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "title": "Severity"
          },
