            "type": "string",
            "title": "Aitech"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "aisubtech": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aisubtech"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "remediation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remediation"
          }
        },
        "type": "object",
        "required": [
          "severity",
          "aitech",
          "title",
          "description"
        ],
        "title": "ScanFinding"
      },
      "ScanRequest": {
        "properties": {
          "skill_text": {
            "type": "string",
            "maxLength": 600000,
            "minLength": 1,
            "title": "Skill Text",
            "description": "Raw concatenated skill package text (SKILL.md plus any scripts). Internal layout is not interpreted; the '### FILE: <path>' convention from scanner.py is fine but not required."
          },
          "skill_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Skill Name",
            "description": "Optional label, interpolated into the analysis prompt only.",
            "default": ""
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Optional per-request litellm model id override (default: env SKILL_SCANNER_LLM_MODEL or 'openrouter/deepseek/deepseek-v3.2')."
          }
        },
        "type": "object",
        "required": [
          "skill_text"
        ],
        "title": "ScanRequest"
      },
      "ScanResponse": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "litellm model id the scan actually used."
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version",
            "description": "Short digest of the threat-analysis prompt that produced this verdict."
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/ScanFinding"
            },
            "type": "array",
            "title": "Findings"
          },
          "overall_assessment": {
            "type": "string",
            "title": "Overall Assessment"
          },
          "primary_threats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Primary Threats"
          }
        },
        "type": "object",
        "required": [
          "model",
          "findings",
          "overall_assessment",
          "primary_threats"
        ],
        "title": "ScanResponse"
      },
      "ScanSkillRequest": {
        "properties": {
          "point_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Point Id",
            "description": "Qdrant point id of the skill in agent_skills."
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash",
            "description": "Alternative lookup: the skill's content_hash payload value."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Optional litellm model id override for the scan."
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "description": "Rescan even if a recent matching llm_scan exists.",
            "default": false
          }
        },
        "type": "object",
        "title": "ScanSkillRequest"
      },
      "ScanSkillResponse": {
        "properties": {
          "point_id": {
            "type": "string",
            "title": "Point Id"
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "llm_scan": {
            "$ref": "#/components/schemas/LlmScan"
          }
        },
        "type": "object",
        "required": [
          "point_id",
          "skipped",
          "llm_scan"
        ],
        "title": "ScanSkillResponse"
      },
