{
  "openapi": "3.1.0",
  "info": {
    "title": "agent-skills / mcp-servers query service",
    "description": "Hybrid search over the agent_skills and mcp_servers Qdrant collections (read-only), a non-deterministic LLM threat scan for skill text (POST /scan), and a scan-and-record path that writes the verdict onto the skill's Qdrant point (POST /scan/skill).",
    "version": "1.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "parameters": [
          {
            "name": "asset_type",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "skill",
                "mcp"
              ],
              "type": "string",
              "default": "skill",
              "title": "Asset Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Health Health Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "summary": "Query",
        "operationId": "query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scan": {
      "post": {
        "summary": "Scan",
        "description": "Non-deterministic threat scan: send the skill text to an LLM (litellm /\nOpenRouter) with the Cisco threat-analysis prompt and return its structured\nfindings / overall_assessment / primary_threats verdict. See scan_service.",
        "operationId": "scan_scan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream LLM call failed or returned unparseable output"
          },
          "503": {
            "description": "Scan LLM not configured (no API key)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scan/skill": {
      "post": {
        "summary": "Scan Skill",
        "description": "Scan an already-indexed skill and record the verdict on its Qdrant point.\n\nIdentify the skill by `point_id` (or `content_hash`); the service reads its\nSKILL.md text, runs the same non-deterministic scan as POST /scan, writes a\ntop-level `llm_scan` payload field, and returns it. A recent scan for\nunchanged content + model + prompt is reused (`skipped: true`) unless\n`force: true`. See scan_index.",
        "operationId": "scan_skill_scan_skill_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanSkillRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanSkillResponse"
                }
              }
            }
          },
          "404": {
            "description": "No agent_skills point matched point_id / content_hash"
          },
          "502": {
            "description": "Upstream LLM call failed or returned unparseable output"
          },
          "503": {
            "description": "Scan LLM not configured (no API key)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LlmScan": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "scanned_at": {
            "type": "string",
            "title": "Scanned At"
          },
          "content_sha256": {
            "type": "string",
            "title": "Content Sha256"
          },
          "max_severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "NONE"
            ],
            "title": "Max Severity"
          },
          "finding_count": {
            "type": "integer",
            "title": "Finding Count"
          },
          "primary_threats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Primary Threats"
          },
          "overall_assessment": {
            "type": "string",
            "title": "Overall Assessment"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/ScanFinding"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "type": "object",
        "required": [
          "model",
          "prompt_version",
          "scanned_at",
          "content_sha256",
          "max_severity",
          "finding_count",
          "primary_threats",
          "overall_assessment",
          "findings"
        ],
        "title": "LlmScan",
        "description": "The `llm_scan` payload field written onto the Qdrant point. Latest\nverdict only -- no history."
      },
      "McpHit": {
        "properties": {
