flowchart LR
    subgraph inputs ["Repo discovery"]
        direction TB
        awesome["awesome-agent-skills/README.md\n(upstream awesome-list)"]
        search["search_github.py\nGitHub Search API"]
        manualEntry["hand-picked repo\n+ reason"]
        marketplace["fetch_marketplace.py\nanthropic claude-plugins-official\nmarketplace.json"]
        pullLb["pull_leaderboard.py\nMANUAL-ONLY -- never automated,\nneeds hand-refreshed VERCEL_OIDC_TOKEN"]
        lbRaw[("leaderboard-raw/\npage-N.json + combined.json")]
        addSkillsh["add_skillsh_leaderboard.py\none row per owner/repo,\nsourceType=github only"]
        agenticAwesome["sickn33/agentic-awesome-skills\nPLANNED -- not implemented\ncurrently tracked as a single manual repo,\nnot yet scraped as an aggregator/seed list"]
    end

    subgraph review ["Human review"]
        direction TB
        queue["github_search_results.json\nreview queue, never read by pipeline"]
        human([you: approve/reject])
    end

    registryPy["registry.py\n(add-manual / add-search / update-skillsh CLI)"]
    registry[("repo-seeds/registry.json\nsingle source of truth, ONE row per repo\nsources: [] -- overlap across channels\nis tracked, not deduped away.\nskills.sh/search descriptors also carry\nrank/skill_count/top_installs (see RANK_SYNC.md)")]

    subgraph env [.env]
        direction TB
        pat[GITHUB_PAT]
        oidc[VERCEL_OIDC_TOKEN]
    end

    subgraph batchRunner ["batch_pipeline.py -- standard pipeline runner, any size"]
        direction TB
        clone[clone_repos.py]
        repos[(repos/\nONE BATCH at a time)]
        extract[extract_search_raw.py]
        raw[(search-raw/\naccumulates across all batches)]
        index["index_qdrant.py\n(incremental: hash-diff, only embeds new/changed;\npayload includes each skill's registry sources + ranking)"]
        db[(qdrant_db/)]
        markSynced["mark_synced_pairs()\nstamps last_synced for THIS\nbatch's confirmed-cloned repos"]
        cleanup["clean_repos.sh\nguarded rm -rf, pinned to repos/ only"]

        clone --> repos
        repos --> extract
        extract --> raw
        raw --> index
        index --> db
        repos -.->|"after extract+index succeed"| markSynced
        repos -->|"batch done"| cleanup
        cleanup -.->|"repos/ empty again"| clone
    end

    legacyRunner["archived/run_pipeline.sh\nLEGACY -- single-shot, clones everything\ninto repos/ at once, no batching.\nKept for reference only."]

    skillsMap["skills_map.py\nupdate_repo(owner, repo)\nreads SKILL.md files straight off repos/,\nnot source-specific metadata"]
    skillsJson[("repo-seeds/skills.json\nskill name -> [{owner, repo, path, sources}]\nsame skill found in N repos is visible here")]

    exportCsv["export_csv.py"]
    csv[("skills_export.csv")]

    stats["stats.py\nsanity check: registry sync status +\nsearch-raw/qdrant/csv counts, all in one report"]

    subgraph consumers ["Query"]
        direction TB
        query[query.py — CLI]
        app[app/streamlit_app.py — web UI]
    end

    user([you])

    awesome -- "build_registry.py (one-time migration)\nregistry.py sync-seed\n(adds an 'officialskills.sh' descriptor -- even to a\nrepo already tracked via another channel)" --> registry
    search -- "ranked candidates" --> queue
    queue --> human
    human -- "registry.py add-search --approve owner/repo" --> registryPy
    manualEntry -- "registry.py add-manual owner/repo reason" --> registryPy
    marketplace -- "no review needed\nadds a 'marketplace' descriptor" --> registry
    registryPy -- "adds a 'search'/'manual'/'skills.sh' descriptor" --> registry
    oidc -.auth.-> pullLb
    pullLb --> lbRaw
    lbRaw --> addSkillsh
    addSkillsh -- "adds a 'skills.sh' descriptor\n(rank, skill_count, top_installs)" --> registry
    agenticAwesome -.->|"not wired up yet\nas an aggregator source"| registryPy

    registry -- "owner/repo pairs, deduped 1:1,\n--only-unsynced filters by\nregistry.unsynced_today()" --> batchRunner
    pat -.auth.-> clone
    clone -- "update_repo() every run,\nwhether repo was cloned or skipped" --> skillsMap
    repos -.->|"scan for SKILL.md"| skillsMap
    registry -.->|"current sources for this repo"| skillsMap
    skillsMap --> skillsJson
    registry -.->|"sources + ranking per repo"| index
    markSynced -.->|"last_synced stamped"| registry

    index -.->|"index_qdrant.py --metadata-only\n(payload-only set_payload push,\nno re-embedding, rank refresh only)"| db

    db --> exportCsv
    exportCsv --> csv

    raw -.->|"disk counts"| stats
    db -.->|"indexed counts"| stats
    registry -.->|"sync status"| stats
    csv -.->|"row count"| stats

    legacyRunner -.->|"equivalent to batchRunner\nwith batch_size = everything"| clone

    db --> query
    db --> app
    user -- "search text" --> query
    user -- "search text" --> app
    query -- "ranked SKILL.md hits" --> user
    app -- "ranked SKILL.md hits" --> user
