openclaw-setup-assistant,"A guided, zero-friction installer and maintenance assistant for OpenClaw. Use this skill when the user wants to install OpenClaw, set up OpenClaw on a local machine or remote server, connect OpenClaw to DingTalk, get OpenClaw skill recommendations for their use case, or perform post-installation maintenance (health checks, troubleshooting, installing new skills, changing AI models, adding chat channels, updating OpenClaw). Handles full environment detection, installation, optional DingTalk integration, scene-based skill recommendations, and daily maintenance — all interactively, with no wasted steps.",NeverSight,learn-skills.dev,194,search_rank=855,search,https://github.com/NeverSight/learn-skills.dev,https://github.com/NeverSight/learn-skills.dev/blob/HEAD/data/skills-md/leroy-zhang/openclaw-setup-assistant/openclaw-setup-assistant/SKILL.md,NeverSight/learn-skills.dev/data/skills-md/leroy-zhang/openclaw-setup-assistant/openclaw-setup-assistant/SKILL.md,1,,0,,908e59863d7b424148b47289f4b9b2684b17c500,,,,,,,"[{""package"": ""openclaw"", ""ecosystem"": ""npm"", ""install_command"": ""npm install -g openclaw@latest""}]",C,"[{""package"": ""openclaw"", ""ecosystem"": ""npm"", ""vuln_count"": 590, ""max_severity"": ""CRITICAL"", ""advisory_ids"": [""GHSA-24vr-rprv-67rf"", ""GHSA-25gx-x37c-7pph"", ""GHSA-25pw-4h6w-qwvm"", ""GHSA-25wv-8phj-8p7r"", ""GHSA-275c-xpvc-jgfw"", ""GHSA-2767-2q9v-9326"", ""GHSA-27cr-4p5m-74rj"", ""GHSA-2858-xg23-26fp"", ""GHSA-2ch6-x3g4-7759"", ""GHSA-2cq5-mf3v-mx44"", ""GHSA-2f7j-rp58-mr42"", ""GHSA-2fgq-7j6h-9rm4"", ""GHSA-2hfg-4fh4-qp7f"", ""GHSA-2hh7-c75g-qj2r"", ""GHSA-2hm8-rqrm-xfjq"", ""GHSA-2mc2-g238-722j"", ""GHSA-2pr2-hcv6-7gwv"", ""GHSA-2qj5-gwg2-xwc4"", ""GHSA-2qrv-rc5x-2g2h"", ""GHSA-2rgf-hm63-5qph"", ""GHSA-2rqg-gjgv-84jm"", ""GHSA-2w79-r9g8-wmcr"", ""GHSA-2ww6-868g-2c56"", ""GHSA-2x4x-cc5g-qmmg"", ""GHSA-2xcp-x87w-q377"", ""GHSA-3298-56p6-rpw2"", ""GHSA-33hm-cq8r-wc49"", ""GHSA-33rq-m5x2-fvgf"", ""GHSA-354r-