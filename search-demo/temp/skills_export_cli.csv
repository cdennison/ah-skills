agent-browser,"Browser automation CLI for AI agents. Use when the user needs to interact with websites, including navigating pages, filling forms, clicking buttons, taking screenshots, extracting data, testing web apps, or automating any browser task. Triggers include requests to ""open a website"", ""fill out a form"", ""click a button"", ""take a screenshot"", ""scrape data from a page"", ""test this web app"", ""login to a site"", ""automate browser actions"", or any task requiring programmatic web interaction.",brycewang-stanford,Auto-Empirical-Research-Skills,3260,search_rank=113,search,https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills,https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills/blob/HEAD/skills/67-econfin-workflow-toolkit/agent-browser/SKILL.md,brycewang-stanford/Auto-Empirical-Research-Skills/skills/67-econfin-workflow-toolkit/agent-browser/SKILL.md,1,,16,"BioTender-max/awesome-bio-agent-skills, actionbook/actionbook, andrelandgraf/fullstackrecipes, arize-ai/phoenix, brianlovin/claude-config, cafe3310/public-agent-skills, m1heng/clawdbot-feishu, nexu-io/open-design, paperclipai/paperclip, pedronauck/skills, qu-skills/skills, shipshitdev/library, sundial-org/awesome-openclaw-skills, vercel-labs/agent-browser",d16bc018f844e7c424c9f1162e2423c360020885,,,,,,,"[{""package"": ""appium"", ""ecosystem"": ""npm"", ""install_command"": ""**Requirements:** macOS with Xcode, Appium (`npm install -g appium && appium driver install xcuitest`)""}]",A,"[{""package"": ""appium"", ""ecosystem"": ""npm"", ""vuln_count"": 0, ""max_severity"": ""none"", ""advisory_ids"": []}]"
