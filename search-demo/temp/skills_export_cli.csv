pr-ready,"Checks if code is ready for a pull request by running type checks, linting, tests, and code quality review for Node.js/TypeScript and Python projects. Use when preparing code for a PR, running pre-commit validation, or when the user asks to check code quality, run linters, run tests, or verify PR readiness.",NeverSight,learn-skills.dev,194,search_rank=855,search,https://github.com/NeverSight/learn-skills.dev,https://github.com/NeverSight/learn-skills.dev/blob/HEAD/data/skills-md/anamtechjay/cowboy-v2/pr-ready/SKILL.md,NeverSight/learn-skills.dev/data/skills-md/anamtechjay/cowboy-v2/pr-ready/SKILL.md,1,,2,"christophacham/agent-skills-library, remotion-dev/remotion",df7afe5be86d0708fc1fb4af26ab7e7035261215,,,,,,,"[{""package"": ""eslint"", ""ecosystem"": ""npm"", ""install_command"": ""npm install eslint --save-dev""}, {""package"": ""jest"", ""ecosystem"": ""npm"", ""install_command"": ""npm install jest --save-dev""}, {""package"": ""typescript"", ""ecosystem"": ""npm"", ""install_command"": ""npm install typescript --save-dev""}, {""package"": ""vitest"", ""ecosystem"": ""npm"", ""install_command"": ""npm install vitest --save-dev""}, {""package"": ""mypy"", ""ecosystem"": ""pip"", ""install_command"": ""pip install mypy  # or: pip install pyright""}, {""package"": ""ruff"", ""ecosystem"": ""pip"", ""install_command"": ""pip install ruff  # or: pip install flake8""}]",C,"[{""package"": ""eslint"", ""ecosystem"": ""npm"", ""vuln_count"": 0, ""max_severity"": ""none"", ""advisory_ids"": []}, {""package"": ""jest"", ""ecosystem"": ""npm"", ""vuln_count"": 0, ""max_severity"": ""none"", ""advisory_ids"": []}, {""package"": ""typescript"", ""ecosystem"": ""npm"", ""vuln_count"": 0, ""max_severity"": ""none"", ""advisory_ids"": []}, {""package"": ""vitest"", ""ecosystem"": ""npm"", ""vuln_count"": 2, ""max_severity"": ""CRITICAL"", ""advisory_ids"": [""GHSA-5xrq-8626-4rwp"", ""GHSA-9crc-q9x8-hgqq""]}, {""package"": ""mypy"", ""ecosystem"": ""pip"", ""vuln_count