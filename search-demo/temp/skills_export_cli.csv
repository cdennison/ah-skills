playwright-testing,"Write and maintain end-to-end tests with Playwright. Use when someone asks to ""add e2e tests"", ""test my web app"", ""set up Playwright"", ""write browser tests"", ""test login flow"", ""visual regression testing"", ""test across browsers"", or ""automate UI testing"". Covers test setup, page objects, authentication, API mocking, visual comparisons, and CI integration.",TerminalSkills,skills,121,search_rank=564,search,https://github.com/TerminalSkills/skills,https://github.com/TerminalSkills/skills/blob/HEAD/skills/playwright-testing/SKILL.md,TerminalSkills/skills/skills/playwright-testing/SKILL.md,1,,2,NeverSight/learn-skills.dev,54549cba2eda3055f4f3cca3b695166c55a79461,,,,,,,"[{""package"": ""@playwright/test"", ""ecosystem"": ""npm"", ""install_command"": ""npm install -D @playwright/test && npx playwright install""}]",A,"[{""package"": ""@playwright/test"", ""ecosystem"": ""npm"", ""vuln_count"": 0, ""max_severity"": ""none"", ""advisory_ids"": []}]"
